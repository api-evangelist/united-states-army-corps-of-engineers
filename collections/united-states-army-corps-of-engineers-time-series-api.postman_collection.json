        {
          "id": "8df956eb-6913-406c-8d97-3004a45314ce",
          "name": "Get Time Series",
          "request": {
            "name": "Get Time Series",
            "description": {
              "content": "Returns time series data for a specified time window. Time series data includes measurements such as river stage, flow, precipitation, temperature, and reservoir pool elevation over time.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "timeseries"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "(Required) The time series identifier in CWMS format (e.g., DALT2.Stage.Inst.15Minutes.0.raw)"
                },
                {
                  "disabled": false,
                  "key": "office",
                  "value": "<string>",
                  "description": "Three-character USACE district office code"
                },
                {
                  "disabled": false,
                  "key": "unit",
                  "value": "<string>",
                  "description": "Measurement unit for the returned data"
                },
                {
                  "disabled": false,
                  "key": "datum",
                  "value": "<string>",
                  "description": "Vertical datum for elevation values"
                },
                {
                  "disabled": false,
                  "key": "begin",
                  "value": "<string>",
                  "description": "Start of time window in ISO 8601 format or milliseconds since epoch"
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<string>",
                  "description": "End of time window in ISO 8601 format or milliseconds since epoch"
                },
                {
                  "disabled": false,
                  "key": "timezone",
                  "value": "<string>",
                  "description": "Timezone for interpreting date/time values"
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "<string>",
                  "description": "Response format"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<string>",
                  "description": "Pagination cursor from a previous response"
                },
                {
                  "disabled": false,
                  "key": "page-size",
                  "value": "<integer>",
                  "description": "Number of time series values per page"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
